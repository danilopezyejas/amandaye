# Optional river conditions configuration. Add to the existing backend environment;
# this file does not replace the Django/database/signing configuration in DEPLOYMENT.md.
# Leave credentials empty until supplied by station owners. Never use VITE_ variables.
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=
WUNDERGROUND_API_KEY=
# This experimental branch uses public pages until each station has API credentials.
# auto: prefer configured API; api: disable scraping; public_page: force scraping.
CONDITIONS_STATION_MODE=auto
# Keys can alternatively be provided using ECOWITT_APPLICATION_KEY_FILE,
# ECOWITT_API_KEY_FILE and WUNDERGROUND_API_KEY_FILE (mounted secret file paths).
CONDITIONS_STALE_MINUTES=20
CONDITIONS_OBSERVATION_CACHE_SECONDS=300
CONDITIONS_FORECAST_CACHE_SECONDS=900
CONDITIONS_FALLBACK_CACHE_SECONDS=3600
CONDITIONS_EXTERNAL_TIMEOUT_SECONDS=5
# Club coastline, taken from the existing club map. Forecast model grid may differ.
CONDITIONS_LATITUDE=-32.3027
CONDITIONS_LONGITUDE=-58.0904
CONDITIONS_WIND_DIFFERENCE_KMH=10
CONDITIONS_GUST_DIFFERENCE_KMH=15
CONDITIONS_TEMPERATURE_DIFFERENCE_C=3
CONDITIONS_PRESSURE_DIFFERENCE_HPA=5
